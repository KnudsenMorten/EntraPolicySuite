{
  "_comment": "Shipped PROPERTY conditions (DESIGN §5.6b kind 1: data, no code). Each one reads one Graph property and compares it with the rule's target. Ids are v1's ConditionType names, so an imported v1 rule set runs unchanged. 'operator': like | notlike | equals | boolMatch (v1 user: target -match TRUE/FALSE) | boolEquals (v1 device: target -eq TRUE/FALSE) | contains | notcontains. 'guard' reproduces v1's own null handling 1:1: none (null is compared as an empty string, as PowerShell -like does), notNull (v1 '-ne $null'), notEmpty (v1 '-and $value'), emptyMatches (v1 EmployeeType_NotLike: an empty value counts as a match). Conditions that need logic (group membership, licences, Exchange) are modules in modules/.",
  "schema": 1,
  "conditions": [
    { "id": "UPN_Like",                      "objectType": "User",   "property": "userPrincipalName",            "operator": "like",       "guard": "none",         "description": "the user's UPN matches a pattern" },
    { "id": "UPN_NotLike",                   "objectType": "User",   "property": "userPrincipalName",            "operator": "notlike",    "guard": "none",         "description": "the user's UPN does not match a pattern" },
    { "id": "AD_OU_DN_Like",                 "objectType": "User",   "property": "onPremisesDistinguishedName",  "operator": "like",       "guard": "none",         "description": "the AD distinguished name (synced users) matches a pattern" },
    { "id": "AD_OU_DN_NotLike",              "objectType": "User",   "property": "onPremisesDistinguishedName",  "operator": "notlike",    "guard": "notEmpty",     "description": "the user is synced and the AD distinguished name does not match a pattern" },
    { "id": "CompanyName_Like",              "objectType": "User",   "property": "companyName",                  "operator": "like",       "guard": "notEmpty",     "description": "the company name is set and matches a pattern" },
    { "id": "CompanyName_NotLike",           "objectType": "User",   "property": "companyName",                  "operator": "notlike",    "guard": "notEmpty",     "description": "the company name is set and does not match a pattern" },
    { "id": "OnPremisesSyncEnabled",         "objectType": "User",   "property": "onPremisesSyncEnabled",        "operator": "boolMatch",  "guard": "none",         "description": "the user is (TRUE) or is not (FALSE) synced from AD" },
    { "id": "MobilePhone_Like",              "objectType": "User",   "property": "mobilePhone",                  "operator": "like",       "guard": "notNull",      "description": "the mobile phone matches a pattern" },
    { "id": "GivenName_Like",                "objectType": "User",   "property": "givenName",                    "operator": "like",       "guard": "notNull",      "description": "the given name matches a pattern" },
    { "id": "SurName_Like",                  "objectType": "User",   "property": "surname",                      "operator": "like",       "guard": "notNull",      "description": "the surname matches a pattern" },
    { "id": "UserType_Like",                 "objectType": "User",   "property": "userType",                     "operator": "like",       "guard": "notNull",      "description": "the user type (Member / Guest) matches a pattern" },
    { "id": "UserType_NotLike",              "objectType": "User",   "property": "userType",                     "operator": "notlike",    "guard": "notNull",      "description": "the user type (Member / Guest) does not match a pattern" },
    { "id": "EmployeeType_Like",             "objectType": "User",   "property": "employeeType",                 "operator": "like",       "guard": "notEmpty",     "description": "the employee type is set and matches a pattern" },
    { "id": "EmployeeType_NotLike",          "objectType": "User",   "property": "employeeType",                 "operator": "notlike",    "guard": "emptyMatches", "description": "the employee type is empty or does not match a pattern" },

    { "id": "AccountEnabled",                "objectType": "Device", "property": "accountEnabled",               "operator": "boolEquals", "guard": "none", "description": "the device is enabled (TRUE) or disabled (FALSE)" },
    { "id": "DeviceCategory_Like",           "objectType": "Device", "property": "deviceCategory",               "operator": "like",       "guard": "none", "description": "the device category matches a pattern" },
    { "id": "DeviceCategory_NotLike",        "objectType": "Device", "property": "deviceCategory",               "operator": "notlike",    "guard": "none", "description": "the device category does not match a pattern" },
    { "id": "DeviceId",                      "objectType": "Device", "property": "deviceId",                     "operator": "equals",     "guard": "none", "description": "the device id is this value" },
    { "id": "DeviceOwnership_Like",          "objectType": "Device", "property": "deviceOwnership",              "operator": "like",       "guard": "none", "description": "the ownership (unknown, company, personal) matches a pattern" },
    { "id": "DeviceOwnership_NotLike",       "objectType": "Device", "property": "deviceOwnership",              "operator": "notlike",    "guard": "none", "description": "the ownership does not match a pattern" },
    { "id": "DisplayName_Like",              "objectType": "Device", "property": "displayName",                  "operator": "like",       "guard": "none", "description": "the device name matches a pattern" },
    { "id": "DisplayName_NotLike",           "objectType": "Device", "property": "displayName",                  "operator": "notlike",    "guard": "none", "description": "the device name does not match a pattern" },
    { "id": "EnrollmentProfileName_Like",    "objectType": "Device", "property": "enrollmentProfileName",        "operator": "like",       "guard": "none", "description": "the enrollment / Autopilot profile name matches a pattern" },
    { "id": "EnrollmentProfileName_NotLike", "objectType": "Device", "property": "enrollmentProfileName",        "operator": "notlike",    "guard": "none", "description": "the enrollment / Autopilot profile name does not match a pattern" },
    { "id": "EnrollmentType_Like",           "objectType": "Device", "property": "enrollmentType",               "operator": "like",       "guard": "none", "description": "the enrollment type matches a pattern" },
    { "id": "EnrollmentType_NotLike",        "objectType": "Device", "property": "enrollmentType",               "operator": "notlike",    "guard": "none", "description": "the enrollment type does not match a pattern" },
    { "id": "Id",                            "objectType": "Device", "property": "id",                           "operator": "equals",     "guard": "none", "description": "the device object id is this value" },
    { "id": "IsCompliant",                   "objectType": "Device", "property": "isCompliant",                  "operator": "boolEquals", "guard": "none", "description": "the device is (TRUE) or is not (FALSE) compliant" },
    { "id": "IsManaged",                     "objectType": "Device", "property": "isManaged",                    "operator": "boolEquals", "guard": "none", "description": "the device is (TRUE) or is not (FALSE) managed" },
    { "id": "Manufacturer_Like",             "objectType": "Device", "property": "manufacturer",                 "operator": "like",       "guard": "none", "description": "the manufacturer matches a pattern" },
    { "id": "Manufacturer_NotLike",          "objectType": "Device", "property": "manufacturer",                 "operator": "notlike",    "guard": "none", "description": "the manufacturer does not match a pattern" },
    { "id": "ManagementType_Like",           "objectType": "Device", "property": "managementType",               "operator": "like",       "guard": "none", "description": "the management type matches a pattern" },
    { "id": "ManagementType_NotLike",        "objectType": "Device", "property": "managementType",               "operator": "notlike",    "guard": "none", "description": "the management type does not match a pattern" },
    { "id": "mdmAppId_Like",                 "objectType": "Device", "property": "mdmAppId",                     "operator": "like",       "guard": "none", "description": "the MDM app id matches a pattern" },
    { "id": "mdmAppId_NotLike",              "objectType": "Device", "property": "mdmAppId",                     "operator": "notlike",    "guard": "none", "description": "the MDM app id does not match a pattern" },
    { "id": "Model_Like",                    "objectType": "Device", "property": "model",                        "operator": "like",       "guard": "none", "description": "the model matches a pattern" },
    { "id": "Model_NotLike",                 "objectType": "Device", "property": "model",                        "operator": "notlike",    "guard": "none", "description": "the model does not match a pattern" },
    { "id": "OnPremisesSyncEnabled",         "objectType": "Device", "property": "onPremisesSyncEnabled",        "operator": "boolEquals", "guard": "none", "description": "the device is (TRUE) or is not (FALSE) synced from AD" },
    { "id": "OperatingSystem_Like",          "objectType": "Device", "property": "operatingSystem",              "operator": "like",       "guard": "none", "description": "the operating system matches a pattern" },
    { "id": "OperatingSystem_NotLike",       "objectType": "Device", "property": "operatingSystem",              "operator": "notlike",    "guard": "none", "description": "the operating system does not match a pattern" },
    { "id": "OperatingSystemVersion_Like",   "objectType": "Device", "property": "operatingSystemVersion",       "operator": "like",       "guard": "none", "description": "the OS version matches a pattern" },
    { "id": "OperatingSystemVersion_NotLike","objectType": "Device", "property": "operatingSystemVersion",       "operator": "notlike",    "guard": "none", "description": "the OS version does not match a pattern" },
    { "id": "PhysicalIds_Contains",          "objectType": "Device", "property": "physicalIds",                  "operator": "contains",   "guard": "none", "description": "the physical ids contain this value" },
    { "id": "PhysicalIds_NotContains",       "objectType": "Device", "property": "physicalIds",                  "operator": "notcontains","guard": "none", "description": "the physical ids do not contain this value" },
    { "id": "ProfileType_Like",              "objectType": "Device", "property": "profileType",                  "operator": "like",       "guard": "none", "description": "the profile type matches a pattern" },
    { "id": "ProfileType_NotLike",           "objectType": "Device", "property": "profileType",                  "operator": "notlike",    "guard": "none", "description": "the profile type does not match a pattern" },
    { "id": "SystemLabels_Contains",         "objectType": "Device", "property": "systemLabels",                 "operator": "contains",   "guard": "none", "description": "the system labels contain this value" },
    { "id": "SystemLabels_NotContains",      "objectType": "Device", "property": "systemLabels",                 "operator": "notcontains","guard": "none", "description": "the system labels do not contain this value" },
    { "id": "TrustType_Like",                "objectType": "Device", "property": "trustType",                    "operator": "like",       "guard": "none", "description": "the trust type (AzureAd, ServerAd, Workplace) matches a pattern" },
    { "id": "TrustType_NotLike",             "objectType": "Device", "property": "trustType",                    "operator": "notlike",    "guard": "none", "description": "the trust type does not match a pattern" }
  ]
}
